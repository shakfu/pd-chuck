#N canvas 50 50 900 560 12;
#X declare -path ..;
#X obj 30 30 loadbang;
#X msg 30 80 reply 1 \, run test/bind_test.ck;
#X obj 30 200 chuck~ 1;
#X obj 60 240 route msg;
#X obj 60 280 route pass fail ready resize done mbang msym mlist mempty;
#X obj 60 330 print BIND-PASS;
#X obj 120 370 print BIND-FAIL;
#X msg 180 410 msg other 1 \, msg note 60 0.8 legato \, msg note 61.7 \, msg cc 7;
#X msg 240 450 \; bt_arr resize 16;
#X obj 300 490 print BIND-DONE;
#X msg 500 490 \; pd quit;
#X obj 500 30 array define bt_arr 8;
#X msg 300 80 \; pd dsp 1;
#X obj 500 80 del 60000;
#X msg 500 120 timeout;
#X obj 700 330 print BIND-MBANG;
#X obj 700 370 print BIND-MSYM;
#X obj 700 410 print BIND-MLIST;
#X obj 700 450 print BIND-MEMPTY;
#X connect 0 0 1 0;
#X connect 0 0 12 0;
#X connect 0 0 13 0;
#X connect 1 0 2 0;
#X connect 2 1 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 4 1 6 0;
#X connect 4 2 7 0;
#X connect 7 0 2 0;
#X connect 4 3 8 0;
#X connect 4 4 9 0;
#X connect 4 4 10 0;
#X connect 13 0 14 0;
#X connect 14 0 6 0;
