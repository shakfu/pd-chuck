#N canvas 50 50 900 600 12;
#X declare -path ..;
#X obj 30 30 loadbang;
#X msg 30 70 reply 1 \, run test/bind_clock.ck;
#X obj 30 500 chuck~ 1;
#X obj 60 530 route msg;
#X obj 60 560 route pass fail done;
#X obj 60 590 print BIND-CLOCK-PASS;
#X obj 200 590 print BIND-CLOCK-FAIL;
#X obj 340 590 print BIND-CLOCK-DONE;
#X msg 400 30 \; pd dsp 1;
#X obj 30 120 del 50;
#X msg 120 120 msg clock tempo 120 \, msg clock play 1;
#X obj 30 170 del 1000;
#X msg 120 170 msg clock seek 1920;
#X obj 30 220 del 1200;
#X msg 120 220 msg clock sig 3 4;
#X obj 30 270 del 1400;
#X msg 120 270 msg clock tempo 60;
#X obj 30 320 del 1600;
#X msg 120 320 msg clock tempo 60;
#X obj 30 370 del 1800;
#X msg 120 370 msg clock play 0;
#X obj 30 420 del 2000;
#X msg 120 420 msg clock bogus 1 \, msg clock tempo -5 \, msg clock sig 0 4;
#X obj 600 120 del 2500;
#X msg 600 160 \; pd quit;
