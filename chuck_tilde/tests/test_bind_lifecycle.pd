#N canvas 50 50 700 560 12;
#X declare -path ..;
#X obj 30 30 loadbang;
#X msg 30 80 reply 1 \, verbose 2 \, run test/bind_lifecycle.ck;
#X obj 30 480 chuck~ 1;
#X msg 300 30 \; pd dsp 1;
#X obj 180 120 del 100;
#X msg 180 150 msg w 1;
#X obj 180 190 del 200;
#X msg 180 220 removeall;
#X obj 180 260 del 300;
#X msg 180 290 msg w 2 \, run test/bind_lifecycle.ck;
#X obj 180 330 del 400;
#X msg 180 360 msg w 3 \, reset;
#X obj 180 400 del 500;
#X msg 180 430 msg w 4 \, run test/bind_lifecycle.ck;
#X obj 450 400 del 600;
#X msg 450 430 msg w 5 \, verbose 1;
#X obj 450 470 del 700;
#X msg 450 500 \; pd quit;
#X connect 0 0 1 0;
